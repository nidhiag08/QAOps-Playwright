{
  "name": "interview-prep",
  "version": "1.0.0",
  "description": "Playwright automation framework for interview prep",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:all-browsers": "ALL_BROWSERS=1 playwright test",
    "test:api": "playwright test --project=api",
    "test:saucedemo": "playwright test tests/PlayWrightLearning --project=chromium",
    "test:rsa": "playwright test tests/ui --project=chromium",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "regression": "playwright test --grep @regression",
    "cucumber": "cucumber-js",
    "test:headed": "playwright test --project=chromium --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --project=chromium --debug=inspector",
    "report": "playwright show-report",
    "codegen": "playwright codegen",
    "excel": "playwright test tests/ui/excelDemo.spec.js --project=chromium",
    "typecheck": "tsc --noEmit",
    "allure:generate": "allure generate allure-results --clean",
    "allure:open": "allure open allure-report",
    "allure:report": "npm run allure:generate && npm run allure:open"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "allure": "^3.33.0",
    "allure-playwright": "^3.14.0",
    "dotenv": "^18.0.8",
    "exceljs": "^4.4.0",
    "typescript": "^7.0.2"
  }
}
